node_modules/
dist/

# QA output — regenerate with tools/capture.mjs
captures/
captures-live/
delivery/qa/

# Editor / OS
.DS_Store
Thumbs.db
*.log

.env.local

# Blender working files from the retired entity pipeline. Kept on disk,
# out of the shipped build. The pattern ends in /* rather than / because
# git cannot re-include a file inside an ignored DIRECTORY.
assets/blender/*
!assets/blender/DL_Entity_Workbench.blend
# The v2 workbench IS the authored source of truth for the Full Form and
# has to be openable by hand, so it is tracked at 105 KB.
!assets/blender/DL_Monolith_Workbench_v2.blend
!assets/blender/DL_Monolith_Workbench_v3.blend
!assets/blender/DL_Monolith_Workbench_v4.blend

# Superseded entity assets. Half a gigabyte of rejected candidates that
# stay on disk for reference; only the immediate predecessor of the
# current production model is tracked.
references/models-archive/*
!references/models-archive/DL_Aurora_v13.glb
tools/blender/__pycache__/
