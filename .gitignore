node_modules/
dist/

# QA output — regenerate with tools/capture.mjs
captures/
captures-live/
delivery/qa/

# Editor / OS
.DS_Store
Thumbs.db
*.log

# Bytecode from the Blender scripts. Regenerated on every run, and the
# two files sitting here belong to scratch scripts that no longer exist.
__pycache__/
*.pyc

# Blender working files. Most are regenerated by the build script, so
# they stay out. The arrangement workbench is the exception: it is
# HAND-AUTHORED and its saved transforms are the source of truth for
# the entity's layout, so losing it means losing the art direction.
# The directory pattern has to end in /* rather than / — git cannot
# re-include a file inside an ignored DIRECTORY.
assets/blender/*
!assets/blender/DL_Entity_Workbench.blend
.env.local

# Raw Meshy candidates. 171 MB of them and most were rejected — the
# built asset below is what the site actually loads, and these stay on
# disk for rebuilds without dragging the history down with them.
public/models/meshy-*.glb
public/models/cand-*.glb
public/models/ring-*.glb
!public/models/DL_Crown_Meshy_v01.glb
public/models/divine-*.glb
public/models/volume-*.glb

# 501 MB of GLB candidates and the full version history of the entity.
# Nothing in the build reads from here — it is kept on disk so a pass
# can be compared against every earlier one without asking the repo to
# carry half a gigabyte of rejected geometry.
references/models-archive/

# Causal Pulse graph binaries. Deterministic from the source GLB —
# regenerate with tools/build-causal-graph.mjs. The manifest IS committed,
# because it is the record of what the spike was measured against.
public/generated/causal-pulse/*.bin
